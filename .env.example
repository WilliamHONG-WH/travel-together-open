+------------------------------------------------------------------------------+
|                                                                              |
|                    TRAVEL TOGETHER  /  山海同行                               |
|               ENVIRONMENT CONFIGURATION  /  环境变量配置模板                   |
|                                                                              |
+------------------------------------------------------------------------------+
|  QUICK GUIDE / 快速指引:                                                     |
|                                                                              |
|  1. Copy this file and rename it to: .env                                    |
|     复制本文件并重命名为：.env                                                |
|                                                                              |
|  2. Replace all values marked with 👉 [REPLACE_WITH_...] 👈                  |
|     将所有带有 👉 [REPLACE_WITH_...] 👈 的占位符替换为你自己的实际密钥            |
+------------------------------------------------------------------------------+


# ==============================================================================
#  BOX 1: DATABASE CONNECTION (REQUIRED / 必填项)
#  Where to find / 密钥获取位置: 
#    Supabase Dashboard -> Project Settings -> API
#    (or your self-hosted Docker PostgreSQL instance / 或你自建的数据库地址)
# ==============================================================================

# [EN] Database API URL
# [ZH] 数据库 API 端点地址
VITE_SUPABASE_URL="https://👉[REPLACE_WITH_YOUR_PROJECT_ID]👈.supabase.co"
SUPABASE_URL="https://👉[REPLACE_WITH_YOUR_PROJECT_ID]👈.supabase.co"

# [EN] Public Client Key (Safe for frontend, protected by Row Level Security)
# [ZH] 前端公开访问密钥（可在网页公开，受数据库行级安全 RLS 保护）
VITE_SUPABASE_PUBLISHABLE_KEY="👉[REPLACE_WITH_YOUR_ANON_KEY]👈"
SUPABASE_PUBLISHABLE_KEY="👉[REPLACE_WITH_YOUR_ANON_KEY]👈"

# [EN] Secret Admin Key (SERVER ONLY - Never expose to the frontend!)
# [ZH] 服务端管理机密密钥（仅供服务器使用，⚠️ 绝不能泄露给前端网页！）
SUPABASE_SERVICE_ROLE_KEY="👉[REPLACE_WITH_YOUR_SERVICE_ROLE_SECRET_KEY]👈"


# ==============================================================================
#  BOX 2: PUSH NOTIFICATIONS (OPTIONAL / 可选功能)
#  How to generate keys / 密钥生成命令 (Terminal / 终端运行):
#    npx web-push generate-vapid-keys
# ==============================================================================

# [EN] Browser Push Subscription Public Key
# [ZH] 网页端推送订阅公钥
VITE_VAPID_PUBLIC_KEY="👉[REPLACE_WITH_YOUR_VAPID_PUBLIC_KEY]👈"

# [EN] Server-side Dispatch Credentials (for Vercel / Node.js backend)
# [ZH] 服务端通知派发凭证（配置到云端服务器环境变量）
VAPID_PUBLIC_KEY="👉[REPLACE_WITH_YOUR_VAPID_PUBLIC_KEY]👈"
VAPID_PRIVATE_KEY="👉[REPLACE_WITH_YOUR_VAPID_PRIVATE_KEY]👈"
VAPID_SUBJECT="mailto:👉[REPLACE_WITH_YOUR_EMAIL@EXAMPLE.COM]👈"


# ==============================================================================
#  BOX 3: MAP TILES (ZERO CONFIG / 无需配置，开箱即用)
# ==============================================================================

# [EN] Vector map is powered by OpenStreetMap (OSM) open-source data.
#      100% Free, keyless, and permanently unmetered. No setup required!
#
# [ZH] 矢量底图完全基于 OpenStreetMap (OSM) 开源地理数据驱动。
#      完全免 API Key、零成本、永久无额度上限，无需进行任何配置！